# NeighborhoodIQ Client Environment Configuration
# NOTE: Variables prefixed with VITE_ are embedded into client-side bundles and visible to all users.
# DO NOT place private API keys, database credentials, or secret tokens here.

# OpenStreetMap Nominatim Geocoding Endpoint (default is the public Nominatim endpoint)
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Overpass API endpoint for OSM amenities querying
VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# OSRM (Open Source Routing Machine) demo routing endpoint
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org

# Optional Public Map Tile URL (defaults to OpenStreetMap standard tiles)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional CPCB / Air Quality Data Service Endpoint (placeholder for custom public proxy)
VITE_AIR_QUALITY_API_URL=https://api.openaq.org/v2/latest

# Feature flag: enable live network fetching with automatic graceful fallback to verified demo data
VITE_ENABLE_LIVE_API=true
